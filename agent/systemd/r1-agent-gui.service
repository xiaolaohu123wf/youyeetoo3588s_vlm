[Unit]
Description=R1 voice assistant GUI (Chromium kiosk)
After=gdm.service r1-orchestrator.service
Wants=gdm.service r1-orchestrator.service
# Do not block boot if orchestrator is slow; open_agent_gui waits internally.
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=oneshot
RemainAfterExit=yes
User=youyeetoo
Group=youyeetoo
Environment=AGENT_ROOT=/userdata/agent
Environment=DISPLAY=:0
Environment=HOME=/home/youyeetoo
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
WorkingDirectory=/userdata/agent
ExecStartPre=/bin/sleep 8
ExecStartPre=/bin/bash -c 'for i in $(seq 1 180); do pgrep -u youyeetoo -x gnome-shell >/dev/null && exit 0; sleep 1; done; echo "WARN: gnome-shell not ready, trying GUI anyway" >&2; exit 0'
ExecStartPre=/bin/bash -c 'sudo -u youyeetoo DISPLAY=:0 bash /userdata/agent/scripts/display_hdmi_only.sh || true'
ExecStartPre=/bin/bash -c 'sudo -u youyeetoo DISPLAY=:0 DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus bash /userdata/agent/scripts/keep_screen_on.sh || true'
ExecStart=/bin/bash /userdata/agent/scripts/autostart_agent_gui.sh
TimeoutStartSec=300

[Install]
WantedBy=graphical.target
