[Unit]
Description=R1 voice agent orchestrator (VAD/ASR/TTS)
After=r1-llm-daemon.service network-online.target sound.target
Requires=r1-llm-daemon.service
Wants=network-online.target

[Service]
Type=simple
User=youyeetoo
Group=youyeetoo
SupplementaryGroups=audio
Environment=AGENT_ROOT=/userdata/agent
Environment=PYTHONPATH=/userdata/agent
Environment=LD_LIBRARY_PATH=/userdata/voice/sherpa-onnx-v1.12.8-linux-aarch64-shared-cpu/lib
Environment=AGENT_MIC_CAPTURE_GAIN=6
WorkingDirectory=/userdata/agent
ExecStartPre=/bin/bash /userdata/agent/scripts/fix_llm_sock_perms.sh /tmp/r1-llm.sock 90
ExecStartPre=/bin/bash /userdata/agent/scripts/wait_fy_sp701.sh
ExecStart=/usr/bin/python3 -m orchestrator.main --config /userdata/agent/config/agent.yaml --agent-root /userdata/agent
StandardOutput=append:/userdata/agent/logs/orchestrator.log
StandardError=append:/userdata/agent/logs/orchestrator.log
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
